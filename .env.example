# ── Required API Keys ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.

# Claude (Anthropic) — required for all AI generation
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenRouter — required for image generation (GPT Image / Gemini)
OPENROUTER_API_KEY=sk-or-v1-...

# ── Optional ───────────────────────────────────────────────────────────────────
# Model to use (default: claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# Public URL of this server (used in PDF image URLs).
# On Render this is auto-set as RENDER_EXTERNAL_URL — no action needed.
# On other platforms set this to your deployed domain:
# PUBLIC_URL=https://techpack-pcj.onrender.com
