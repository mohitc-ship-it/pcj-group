            {
                "name": "COTTON RIB KNIT, 180-240 GSM",
                "why": "Used for lightweight or transitional-season turtlenecks. Brands like Uniqlo and Everlane use heavyweight cotton rib for FW turtlenecks. Less warm than wool but more affordable and easier care."
            },
            {
                "name": "VISCOSE/MODAL KNIT, 160-220 GSM",
                "why": "Used for fitted, drapey turtlenecks — common in contemporary womenswear (ASOS, & Other Stories). Softer hand than cotton, good for layering pieces."
            },
            {
                "name": "CASHMERE KNIT, 150-200 GSM",
                "why": "Luxury turtleneck standard — finer gauge, lighter GSM but extremely warm. Used by luxury brands (Loro Piana, Brunello Cucinelli). Lower GSM than wool because cashmere fibres trap more air."
            }
